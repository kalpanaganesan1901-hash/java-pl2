import java.util.*;

class Main {
    static long[] resultArray(int[] nums, int k) {
        long[] ans = new long[k];
        long[] dp = new long[k];

        for (int num : nums) {
            int r = num % k;
            long[] next = new long[k];

            next[r] = 1;

            for (int i = 0; i < k; i++) {
                int nr = (int)((long)i * r % k);
                next[nr] += dp[i];
            }

            for (int i = 0; i < k; i++) {
                ans[i] += next[i];
            }

            dp = next;
        }

        return ans;
    }

    public static void main(String[] args) {
        int[] nums = {1, 2, 3, 4, 5};
        int k = 3;

        long[] ans = resultArray(nums, k);

        System.out.println(Arrays.toString(ans));
    }
}
